
# Descriptive name for the system
system.name = cooc

# Quantum mechanical description
system.spinType = NoSpin
system.neutralAtomDataDirectory = '../siestaBasisGGA'
system.orbitalType = DZP
calculation.xcFunctional.Type = GGA_PBE96
calculation.occupationFunction.temperature = 300
# Positions and chemical species of the atoms
calculation.control.lengthUnit =  angstrom
system.centralCellVectors =  [[8.59046 0.0 0.0]',[0.0  4.9597 0.0]',[0.0  0.0 70.7619904758]'] 
system.atomFile = cooc.xyz

# Leads information
system.numberOfLeads = 2
system.typeOfLead1 = Left
system.voltageOfLead1 = 0.0
system.objectOfLead1 = ../L/NanodcalObject.mat
system.typeOfLead2 = Right
system.voltageOfLead2 = 0.0
system.objectOfLead2 = ../R/NanodcalObject.mat

calculation.k_spacegrids.number = [4,4,1]

calculation.control.precision = 'low'

# Control parameters

## What quantities should be calculated
calculation.name = scf

## Accuracy of the calculation
#calculation.realspacegrids.number = [128 128 225]

## Speed of convergence of the algorithms
calculation.SCF.startingMode = H
calculation.SCF.mixingMode = H
calculation.SCF.mixMethod = Broyden
calculation.SCF.mixRate = 0.0001
calculation.SCF.maximumSteps = 300
calculation.SCF.donatorObject = NanodcalObject.mat
calculation.SCF.maximumTime = 24


## Format for input and output of information
calculation.control.energyUnit = Hartree








